# ============================================================================
# Variables de Entorno - BanQuito Core Bancario (PLANTILLA)
# Copiar este archivo como .env y completar los valores reales
# IMPORTANTE: Todas las variables deben empezar con VITE_ para ser accesibles
# ============================================================================

# --- API ---
# Para desarrollo local: Dejar vacío o usar http://localhost:8081/api/v1/core
# Para nube: Usar la URL de producción
VITE_API_BASE_URL=http://localhost:8081/api/v1/core

# --- Aplicación ---
VITE_APP_NAME=BanQuito
VITE_APP_SUBTITLE=Core Bancario

# --- Autenticación ---
VITE_MOCK_AUTH_ENABLED=true
VITE_DEFAULT_ADMIN_USER=admin

# --- Entorno ---
VITE_ENVIRONMENT=development
